<Window x:Class="MockBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MockBench"
        xmlns:conv="clr-namespace:MockBench.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <conv:DirectionToBrushConverter x:Key="DirectionToBrush"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="TARGET IP" FontSize="10"/>
                <TextBox Text="{Binding TargetIp, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="PORT" FontSize="10"/>
                <TextBox Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                <TextBlock Text="DEVICE PROFILE" FontSize="10"/>
                <ComboBox Width="140" SelectedIndex="0">
                    <ComboBoxItem Content="ETC Echo"/>
                    <ComboBoxItem Content="+ New profile..."/>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                <TextBlock Text="MODE" FontSize="10"/>
                <ToggleButton x:Name="ModeToggle" Content="Live ▶ Send" Width="140" VerticalAlignment="Bottom"/>
            </StackPanel>
            
            <Button Content="Save Session..." Command="{Binding SaveSessionCommand}" Margin="20,0,0,0" VerticalAlignment="Bottom"/>
            <Button Content="Load Session..." Command="{Binding LoadSessionCommand}" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
            <Button Content="Clear Log" Command="{Binding ClearLogCommand}" Margin="20,0,0,0" VerticalAlignment="Bottom"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="LABEL" FontSize="10"/>
                <TextBox Text="{Binding LabelInput, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="HEX PAYLOAD" FontSize="10"/>
                <TextBox Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Send ▸" Command="{Binding SendCommand}" VerticalAlignment="Bottom" Padding="14,6"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar area -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="Gray">
                <StackPanel Margin="10">
                    <TextBlock Text="SAVED COMMANDS" FontSize="10" Margin="0,0,0,8"/>
                    <ListBox>
                        <ListBoxItem Content="Set Ch3 Volume -10dB"/>
                        <ListBoxItem Content="Mute Ch3"/>
                        <ListBoxItem Content="Query Status"/>
                        <ListBoxItem Content="Set Space Off"/>
                    </ListBox>
                </StackPanel>
            </Border>
           
            <!-- Log panel -->
            <ListView Grid.Column="1" Margin="10" ItemsSource="{Binding Log}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}"/>
                        <GridViewColumn Header="Dir" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Dir}" Foreground="{Binding Dir, Converter={StaticResource DirectionToBrush}}" FontWeight="Bold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Bytes" Width="260" DisplayMemberBinding="{Binding MessageHex}"/>
                        <GridViewColumn Header="Label" Width="140" DisplayMemberBinding="{Binding Label}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="● Listening on 0.0.0.0:9990"/>
            </StatusBarItem>
            
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="4 packets logged this session"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
