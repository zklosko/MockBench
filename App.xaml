<Application x:Class="MockBench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MockBench"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#1B1E23"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#22262C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#D8DCE2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5FB0A3"/>

    </Application.Resources>
</Application>
